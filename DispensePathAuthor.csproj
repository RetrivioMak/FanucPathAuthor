<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DispensePathAuthor</RootNamespace>
    <AssemblyName>DispensePathAuthor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <InformationalVersion>1.0.4 Alpha</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- SDK includes all *.cs recursively; keep the test project and plugin projects out of the WinExe build. -->
  <ItemGroup>
    <Compile Remove="DispensePathAuthor.Tests\**" />
    <Compile Remove="DispensePathAuthor.Contracts\**" />
    <Compile Remove="DispensePathAuthor.Xyz\**" />
    <EmbeddedResource Remove="DispensePathAuthor.Tests\**" />
    <EmbeddedResource Remove="DispensePathAuthor.Contracts\**" />
    <EmbeddedResource Remove="DispensePathAuthor.Xyz\**" />
    <None Remove="DispensePathAuthor.Tests\**" />
    <None Remove="DispensePathAuthor.Contracts\**" />
    <None Remove="DispensePathAuthor.Xyz\**" />
    <Content Remove="DispensePathAuthor.Tests\**" />
    <Content Remove="DispensePathAuthor.Contracts\**" />
    <Content Remove="DispensePathAuthor.Xyz\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DispensePathAuthor.Contracts\DispensePathAuthor.Contracts.csproj" />
    <ProjectReference Include="DispensePathAuthor.Xyz\DispensePathAuthor.Xyz.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>PluginAssembly</OutputItemType>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <Copy SourceFiles="@(PluginAssembly)" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>

  <!-- DXF types are used only by Services/DxfImporter.cs. -->
  <ItemGroup>
    <PackageReference Include="netDxf" Version="2023.11.10" />
  </ItemGroup>

  <!-- Legacy VS template file, if present, conflicts with SDK-generated assembly info. -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" Condition="Exists('Properties\AssemblyInfo.cs')" />
  </ItemGroup>
</Project>
