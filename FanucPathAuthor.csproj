<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FanucPathAuthor</RootNamespace>
    <AssemblyName>FanucPathAuthor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <InformationalVersion>1.0.4 Alpha</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- SDK includes all *.cs recursively; keep the test project out of the WinExe build. -->
  <ItemGroup>
    <Compile Remove="FanucPathAuthor.Tests\**" />
    <EmbeddedResource Remove="FanucPathAuthor.Tests\**" />
    <None Remove="FanucPathAuthor.Tests\**" />
    <Content Remove="FanucPathAuthor.Tests\**" />
  </ItemGroup>

  <!-- Legacy VS template file, if present, conflicts with SDK-generated assembly info. -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" Condition="Exists('Properties\AssemblyInfo.cs')" />
  </ItemGroup>
</Project>
